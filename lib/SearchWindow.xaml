<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EZ Triage - Search IOCs" Width="900" Height="720" MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="#F3F4F6" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <Style TargetType="GroupBox">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#D6D9DD"/>
      <Setter Property="Padding" Value="8,6,8,8"/>
      <Setter Property="HeaderTemplate">
        <Setter.Value>
          <DataTemplate><TextBlock Text="{Binding}" FontWeight="SemiBold"/></DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="MinHeight" Value="26"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#5A636E"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Window.Resources>

  <Grid Margin="12,10,12,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="150"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="150"/>
    </Grid.RowDefinitions>

    <GroupBox Grid.Row="0" Header="Where to search">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="TxtRoot" Padding="3,3" VerticalContentAlignment="Center" Margin="0,2"/>
        <Button Grid.Column="1" x:Name="BtnRoot" Content="Browse..." MinWidth="80" Margin="6,2,0,2"/>
        <TextBlock Grid.Row="1" x:Name="LblRoot" Style="{StaticResource Hint}" Margin="0,2,0,0"
                   Text="A case folder, or a folder that holds several case folders (several collections). Only the tool output (CSV files) is searched, never the evidence."/>
      </Grid>
    </GroupBox>

    <GroupBox Grid.Row="1" Header="IOCs" Margin="0,10,0,0">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <Button DockPanel.Dock="Right" x:Name="BtnLoad" Content="Load .txt..." Margin="6,0,0,0"/>
          <Button DockPanel.Dock="Right" x:Name="BtnClear" Content="Clear"/>
          <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                     Text="One per line: user names, IPs, file names, paths, hashes, domains. Lines starting with # are ignored. Defanged IOCs (evil[.]com, hxxp://) are fixed automatically."/>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" x:Name="LblIocs" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
        <TextBox x:Name="TxtIocs" AcceptsReturn="True" AcceptsTab="False" FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" Padding="4,3"/>
      </DockPanel>
    </GroupBox>

    <DockPanel Grid.Row="2" Margin="0,10,0,6" LastChildFill="True">
      <Button DockPanel.Dock="Left" x:Name="BtnSearch" Content="Search" MinWidth="110" MinHeight="30" FontWeight="SemiBold"/>
      <Button DockPanel.Dock="Left" x:Name="BtnStop" Content="Cancel" MinWidth="80" MinHeight="30" Margin="6,0,0,0" IsEnabled="False"/>
      <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="LblProgress" Text="Ready" Foreground="#2B3138" TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <ProgressBar x:Name="PrgSearch" Height="6" Margin="0,4,0,0" Minimum="0" Maximum="100" Value="0"/>
      </StackPanel>
    </DockPanel>

    <GroupBox Grid.Row="3" Header="Results">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
          <Button x:Name="BtnOpenHits" Content="Open hits in Timeline Explorer" IsEnabled="False"/>
          <Button x:Name="BtnOpenSummary" Content="Open summary" Margin="6,0,0,0" IsEnabled="False"
                  ToolTip="Summary.csv: one row per IOC per host, with the full hit counts"/>
          <Button x:Name="BtnOpenLog" Content="Open search log" Margin="6,0,0,0" IsEnabled="False"/>
          <Button x:Name="BtnOpenDir" Content="Open results folder" Margin="6,0,0,0" IsEnabled="False"/>
        </StackPanel>
        <TextBox x:Name="TxtResults" FontFamily="Consolas" FontSize="12" IsReadOnly="True" Background="#FBFBFC" BorderBrush="#E1E4E8"
                 Padding="6,4" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
      </DockPanel>
    </GroupBox>
  </Grid>
</Window>
